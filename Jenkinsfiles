//jenkins file for my scm repo
//my jenkins file for deployment 

pipeline {
    agent {
        label {
            label "built-in"
            customWorkspace "/mnt/project"
        }
    }

    stages {

        stage("stop httpd") {
            steps {
                sh "service httpd stop || true"
                sleep 5
            }
        }

        stage("prepare html directory") {
            steps {
                sh "mkdir -p /var/www/html"
                sh "rm -rf /var/www/html/*"
            }
        }

        stage("deploy html") {
            steps {
                sh "cp index.html /var/www/html/"
                sh "cp dev.html /var/www/html/"
                sh "chmod -R 755 /var/www/html"
            }
        }

        stage("start httpd") {
            steps {
                sh "httpd -t"
                sh "service httpd start"
                sleep 5
            }
        }
    }
}

